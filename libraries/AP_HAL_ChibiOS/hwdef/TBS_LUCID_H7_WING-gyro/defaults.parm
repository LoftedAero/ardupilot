# Default parameters for the TBS Lucid H7 Wing gyro build.
# These make a freshly flashed board behave like an RC gyro with an
# arm switch: ELRS AUX1 (channel 5) arms, a three-position mode switch
# on channel 6, RTL on channel 7, gain knob on channel 8, and link-loss
# handling that never needs a GPS.

# --- Arming: switch on channel 5 (ELRS AUX1), throttle must be low, other optional checks skipped, no rudder arming ---
# Throttle is held at minimum PWM while disarmed so the ESC stays quiet.
ARMING_REQUIRE 1
# Skip every optional check except RC (-65 = all bits but bit 6), and with RC_OPTIONS
# 96 run only its throttle part: arming is refused unless the throttle is low.
ARMING_SKIPCHK -65
RC_OPTIONS 96
ARMING_RUDDER 0
RC5_OPTION 153
INS_GYR_CAL 1

# --- Sensors ---
COMPASS_ENABLE 0
AHRS_EKF_TYPE 0
ARSPD_TYPE 0

# --- RC input: ELRS/CRSF on SERIAL6 (R6/T6 pads), standard CRSF endpoints ---
# RSSI_TYPE 3 shows link quality from the receiver.
SERIAL6_PROTOCOL 23
RSSI_TYPE 3
RC_PROTOCOLS 512
RC1_MIN 988
RC1_MAX 2012
RC2_MIN 988
RC2_MAX 2012
RC3_MIN 988
RC3_MAX 2012
RC4_MIN 988
RC4_MAX 2012
RC5_MIN 988
RC5_MAX 2012
RC6_MIN 988
RC6_MAX 2012
RC7_MIN 988
RC7_MAX 2012
RC8_MIN 988
RC8_MAX 2012

# --- Mode switch: 3-position on channel 6 -> MANUAL / ACRO / FBWA ---
FLTMODE_CH 6
FLTMODE1 0
FLTMODE2 0
FLTMODE3 4
FLTMODE4 4
FLTMODE5 5
FLTMODE6 5
INITIAL_MODE 0

# --- RTL on channel 7 (only useful with a GPS and home set) ---
RC7_OPTION 4

# --- Gain knob on channel 8: master gain for the rate controllers ---
GYRO_GAIN_CH 8
GYRO_GAIN_MIN 0
GYRO_GAIN_MAX 1.5

# --- Trims: set servo trims in the menu (4 Outputs, Channel N, Trim); auto-trim in FBWA with a GPS ---
SERVO_AUTO_TRIM 1
STICK_MIXING 0

# --- Link loss: short = FBWA at zero throttle; long = RTL if home is set, else FBWA glide
THR_FAILSAFE 1
FS_SHORT_ACTN 2
FS_SHORT_TIMEOUT 1
FS_LONG_ACTN 1
FS_LONG_TIMEOUT 5
FS_GCS_ENABL 0

# --- ACRO feel ---
ACRO_ROLL_RATE 180
ACRO_PITCH_RATE 90
ACRO_LOCKING 0

# --- Logging: while armed only ---
LOG_DISARMED 0

# --- Board specifics carried over from the stock Lucid H7 Wing defaults ---
# WS2812 LED strip on output 13
SERVO13_FUNCTION 120
# VTX power relay on by default
RELAY4_DEFAULT 1
