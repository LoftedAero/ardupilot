# Default parameters for the TBS Lucid H7 Wing gyro build.
# These make a freshly flashed board behave like an RC gyro with an
# arm switch: ELRS AUX1 (channel 5) arms, a three-position mode switch
# on channel 6, RTL on channel 7, gain knob on channel 8, and link-loss
# handling that never needs a GPS.

# --- Arming: switch on channel 5 (ELRS AUX1), throttle must be low, other optional checks skipped, no rudder arming ---
# Throttle is held at minimum PWM while disarmed so the ESC stays quiet.
ARMING_REQUIRE 1
# Run the RC and INS checks (-81 = all bits skipped but 4 and 6), and with RC_OPTIONS
# 96 run only its throttle part: arming is refused unless the throttle is low.
# INS: gyros and accelerometers healthy and calibrated (run "Calibrate accel" once
# before the first flight) and the attitude estimate ready. The GPS checks (bits 3
# and 12) run only while the GPS is on (menu: 1 Sensors, GPS).
# RC_OPTIONS bit 12 (4096) adds a star to the CRSF flight mode while disarmed, which is
# the only way a radio on plain CRSF telemetry can tell armed from disarmed.
ARMING_SKIPCHK -81
RC_OPTIONS 4192
ARMING_RUDDER 0
RC5_OPTION 153
INS_GYR_CAL 1

# --- Sensors ---
COMPASS_ENABLE 0
# --- GPS: off by default (menu: 1 Sensors, GPS) ---
# Off: no GPS driver, DCM attitude estimate. On: GPS1_TYPE 1, EKF3, GPS arming checks.
GPS1_TYPE 0
EK3_ENABLE 0
AHRS_EKF_TYPE 0
ARSPD_TYPE 0

# --- RC input: ELRS/CRSF on SERIAL6 (R6/T6 pads), standard CRSF endpoints (2 Radio > Learn
#     sticks and Learn gain knob measure the real ones) ---
# RSSI_TYPE 3 shows link quality from the receiver.
SERIAL6_PROTOCOL 23
RSSI_TYPE 3
RC_PROTOCOLS 512
RC1_MIN 988
RC1_MAX 2012
RC2_MIN 988
RC2_MAX 2012
RC3_MIN 988
RC3_MAX 2012
RC4_MIN 988
RC4_MAX 2012
RC5_MIN 988
RC5_MAX 2012
RC6_MIN 988
RC6_MAX 2012
RC7_MIN 988
RC7_MAX 2012
RC8_MIN 988
RC8_MAX 2012
RC9_MIN 988
RC9_MAX 2012
RC10_MIN 988
RC10_MAX 2012
RC11_MIN 988
RC11_MAX 2012
RC12_MIN 988
RC12_MAX 2012
RC13_MIN 988
RC13_MAX 2012
RC14_MIN 988
RC14_MAX 2012
RC15_MIN 988
RC15_MAX 2012
RC16_MIN 988
RC16_MAX 2012

# --- Mode switch: 3-position on channel 6 -> MANUAL / ACRO / FBWA ---
FLTMODE_CH 6
FLTMODE1 0
FLTMODE2 0
FLTMODE3 4
FLTMODE4 4
FLTMODE5 5
FLTMODE6 5
INITIAL_MODE 0

# --- RTL on channel 7 (only useful with a GPS and home set) ---
RC7_OPTION 4

# --- Gain knob on channel 8: master gain for the rate controllers ---
STABRX_GAIN_CH 8
STABRX_GAIN_MIN 0
STABRX_GAIN_MAX 3

# --- Turns without a GPS: assumed airspeed for the attitude estimate's turn correction.
# Set the model's cruise speed in the menu (6 Tuning, Speeds): it writes SCALING_SPEED and
# AIRSPEED_CRUISE. AIRSPEED_CRUISE starts at the stock SCALING_SPEED so the two agree.
STABRX_TURN_CORR 1
AIRSPEED_CRUISE 15

# --- Trims: set servo trims in the menu (4 Outputs, Channel N, Trim); auto-trim in FBWA with a GPS ---
SERVO_AUTO_TRIM 1
STICK_MIXING 0

# --- Rudder: the yaw damper (menu 6 Tuning, Yaw gains: Yaw damper = YAW2SRV_DAMP, 0 = off) also runs in ACRO
# (FLIGHT_OPTIONS bit 5); a small aileron to rudder mix in FBWA and ACRO
FLIGHT_OPTIONS 32
KFF_RDDRMIX 0.2
# a low start value for the yaw damper (no effect without a rudder); autotune
# sets it for the model
YAW2SRV_DAMP 0.05

# --- Autotune: roll, pitch and the yaw damper. The yaw autotune tunes the
# yaw rate controller, enabled for that only: ACRO_YAW_RATE stays 0, so the
# rudder is on the damper in every mode (no tail lock in ACRO), and the
# StabRX module copies the tuned YAW_RATE_P to YAW2SRV_DAMP. Level 8 sets a
# 0.2 s time constant and a 120 deg/s rate limit for FBWA (stock 6: 0.5 s,
# 75 deg/s); ACRO is limited only by the ACRO rates ---
AUTOTUNE_AXES 7
AUTOTUNE_LEVEL 8
YAW_RATE_ENABLE 1
ACRO_YAW_RATE 0

# --- Link loss: short = FBWA at zero throttle; long = RTL if home is set, else FBWA glide
THR_FAILSAFE 1
FS_SHORT_ACTN 2
RC_FS_TIMEOUT 1
FS_LONG_ACTN 1
FS_LONG_TIMEOUT 5
FS_GCS_ENABL 0

# --- FBWA bank and pitch limits (menu 6 Tuning); stock is 45 bank, 20 up,
# -25 down ---
ROLL_LIMIT_DEG 65
PTCH_LIM_MAX_DEG 45
PTCH_LIM_MIN_DEG -30

# --- ACRO feel: the full-stick rates are the only ACRO limit. ACCEL 0
# turns off the input shaping that would also cap ACRO at the autotune
# RMAX and slow its rate changes; FBWA keeps the RMAX limit ---
ACRO_ROLL_RATE 360
ACRO_PITCH_RATE 180
ACRO_LOCKING 0
RLL2SRV_ACCEL 0
PTCH2SRV_ACCEL 0

# --- Logging: while armed only ---
LOG_DISARMED 0

# --- Board specifics carried over from the stock Lucid H7 Wing defaults ---
# WS2812 LED strip on output 13
SERVO13_FUNCTION 120
# VTX power relay on by default
RELAY4_DEFAULT 1
